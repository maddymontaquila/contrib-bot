{
  "name": "contrib-bot",
  "version": "1.0.0",
  "description": "Discord Linked Roles app for repository contribution verification",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "preview": "tsx watch src/preview.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "keywords": [
    "discord",
    "github",
    "contributions",
    "linked-roles",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@octokit/rest": "^22.0.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
